<style id="site-nav-consistency">
/* Unified site navigation */
.nav{height:66px!important;padding:0 40px!important;background:var(--c-dark,var(--dark,#0c1b2e))!important;display:flex!important;align-items:center!important;gap:0!important;position:sticky!important;top:0;left:0;right:0;z-index:1000;box-shadow:0 2px 20px rgba(0,0,0,.18);backdrop-filter:none!important;-webkit-backdrop-filter:none!important;transition:box-shadow .2s,background .2s!important}
.nav-scrolled{background:var(--c-dark,var(--dark,#0c1b2e))!important;box-shadow:0 2px 20px rgba(0,0,0,.18)!important}
.nav-logo{font-family:var(--font-h,var(--font-serif,'Cormorant Garamond',Georgia,serif))!important;font-size:22px!important;font-weight:700!important;color:#fff!important;text-decoration:none!important;letter-spacing:-.01em!important;margin-right:auto!important;flex-shrink:0!important;line-height:1!important}
.nav-logo em{font-style:italic!important;color:var(--c-secondary,var(--gold,#c47832))!important}
.nav-links{display:flex!important;align-items:center!important;gap:0!important;list-style:none!important;margin:0 0 0 auto!important;padding:0!important;position:static!important;width:auto!important;height:auto!important;background:transparent!important;box-shadow:none!important;overflow:visible!important}
.nav-links li{list-style:none!important;position:relative!important;width:auto!important;margin:0!important;padding:0!important}
.nav-links a{display:flex!important;align-items:center!important;justify-content:center!important;height:66px!important;min-height:0!important;padding:0 10px!important;border:0!important;border-radius:0!important;color:rgba(255,255,255,.78)!important;font-family:var(--font-b,var(--font-body,'DM Sans',sans-serif))!important;font-size:13px!important;font-weight:500!important;letter-spacing:.25px!important;text-decoration:none!important;white-space:nowrap!important;line-height:1.2!important;transition:color .2s,background .2s!important;transform:none!important}
.nav-links a:hover{color:#fff!important;background:rgba(255,255,255,.07)!important;transform:none!important}
.nav-phone{color:rgba(255,255,255,.68)!important;font-size:13px!important;padding:0 10px!important}
.nav-tool{color:var(--c-secondary,var(--gold,#c47832))!important;border:1px solid rgba(196,120,50,.4)!important;border-radius:6px!important;height:34px!important;margin-left:6px!important;padding:0 12px!important}
.nav-tool:hover{background:rgba(196,120,50,.14)!important;color:#e09040!important}
.nav-cta{background:var(--c-accent,var(--accent,#8b2252))!important;color:#fff!important;height:36px!important;padding:0 16px!important;border-radius:6px!important;margin-left:8px!important;font-weight:600!important;border-bottom:0!important}
.nav-cta:hover{background:#721c45!important;color:#fff!important}
.hamburger{display:none;flex-direction:column;justify-content:center;gap:5px;width:38px;height:38px;background:transparent;border:0;padding:4px;cursor:pointer;z-index:1100;flex-shrink:0}
.hamburger span{display:block;width:100%;height:2px;background:#fff;border-radius:2px;transition:transform .25s,opacity .25s}
.hamburger.active span:nth-child(1),.hamburger.open span:nth-child(1){transform:translateY(7px) rotate(45deg)}
.hamburger.active span:nth-child(2),.hamburger.open span:nth-child(2){opacity:0}
.hamburger.active span:nth-child(3),.hamburger.open span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}
@media(max-width:900px){.nav{height:64px!important;padding:0 22px!important;position:sticky!important}.hamburger{display:flex!important}.nav-links{position:fixed!important;top:0!important;right:-100%!important;width:min(320px,82vw)!important;height:100vh!important;background:var(--c-dark,var(--dark,#0c1b2e))!important;flex-direction:column!important;align-items:flex-start!important;padding:88px 24px 40px!important;box-shadow:-8px 0 40px rgba(0,0,0,.28)!important;transition:right .3s ease!important;overflow-y:auto!important}.nav-links.open,.nav-links.active{right:0!important}.nav-links li{width:100%!important}.nav-links a{width:100%!important;height:auto!important;min-height:48px!important;padding:13px 0!important;justify-content:flex-start!important;border-bottom:1px solid rgba(255,255,255,.07)!important;font-size:15px!important}.nav-phone{font-size:15px!important}.nav-tool{margin-left:0!important;border:0!important;border-radius:0!important;height:auto!important}.nav-cta{margin:16px 0 0 0!important;justify-content:center!important;border-bottom:0!important;border-radius:6px!important;min-height:52px!important;width:100%!important}}
</style>
<style id="site-updates-strip">
/* Compact current updates carousel */
.site-updates{background:#f7f3ed;border-bottom:1px solid rgba(12,27,46,.1);overflow:hidden;position:relative;z-index:20}
.site-updates-inner{display:grid;grid-template-columns:auto minmax(0,1fr);align-items:center;gap:18px;min-height:74px;padding:12px 0 12px 40px}
.site-updates-label{display:flex;flex-direction:column;justify-content:center;gap:2px;min-width:142px;color:var(--c-dark,var(--navy,#0c1b2e));font-family:var(--font-b,var(--font-body,'DM Sans',sans-serif))}
.site-updates-label span:first-child{font-size:10px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:var(--c-accent,var(--accent,#8b2252))}
.site-updates-label span + span{font-size:13px;font-weight:700;line-height:1.2}
.site-updates-viewport{position:relative;overflow:hidden;padding:2px 0}
.site-updates-viewport::before,.site-updates-viewport::after{content:'';position:absolute;top:0;width:min(9vw,96px);height:100%;z-index:2;pointer-events:none}.site-updates-viewport::before{left:0;background:linear-gradient(90deg,#f7f3ed,rgba(247,243,237,0))}.site-updates-viewport::after{right:0;background:linear-gradient(270deg,#f7f3ed,rgba(247,243,237,0))}
.site-updates-track{display:flex;width:max-content;gap:12px;animation:siteUpdatesScroll 58s linear infinite;will-change:transform}.site-updates:hover .site-updates-track{animation-play-state:paused}
.site-update-card{display:inline-flex;align-items:center;gap:10px;min-height:46px;padding:9px 14px;border:1px solid rgba(12,27,46,.12);border-radius:8px;background:#fff;color:var(--c-body,#374151);box-shadow:0 6px 18px rgba(12,27,46,.07);text-decoration:none;white-space:nowrap;font-family:var(--font-b,var(--font-body,'DM Sans',sans-serif));transition:transform .2s ease,border-color .2s ease,box-shadow .2s ease}
.site-update-card:hover{transform:translateY(-1px);border-color:rgba(196,120,50,.38);box-shadow:0 10px 24px rgba(12,27,46,.11)}
.site-update-type{font-size:10px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--c-secondary,var(--gold,#c47832))}.site-update-title{font-size:13px;font-weight:800;color:var(--c-dark,var(--navy,#0c1b2e))}.site-update-meta{font-size:12px;color:#667085}.site-update-dot{width:4px;height:4px;border-radius:50%;background:rgba(12,27,46,.28);flex:0 0 auto}
@keyframes siteUpdatesScroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@media(max-width:900px){.site-updates-inner{grid-template-columns:1fr;gap:8px;min-height:0;padding:12px 0 12px 20px}.site-updates-label{min-width:0;flex-direction:row;align-items:center;gap:10px}.site-updates-label span + span{font-size:12px}.site-updates-track{animation-duration:46s}.site-update-card{min-height:42px;padding:8px 12px}.site-update-title{font-size:12px}.site-update-meta{font-size:11px}}
@media(prefers-reduced-motion:reduce){.site-updates-track{animation:none;flex-wrap:nowrap;overflow-x:auto;width:auto;padding-right:20px}.site-updates-viewport{overflow-x:auto}.site-updates-viewport::before,.site-updates-viewport::after{display:none}}
</style>
