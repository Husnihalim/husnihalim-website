 <!-- Schema: FAQPage -->
 <script type="application/ld+json">
 {
 "@context": "https://schema.org",
 "@type": "FAQPage",
 "mainEntity": [
 {
 "@type": "Question",
 "name": "What is the difference between your training and consulting services?",
 "acceptedAnswer": {
 "@type": "Answer",
 "text": "Training transfers knowledge and skills to your team — typically 1–2 day programs, HRDC claimable, focused on building capability. Consulting is hands-on operational work where I join your team on-site for weeks or months to design, implement, and sustain actual improvements in your factory."
 }
 },
 {
 "@type": "Question",
 "name": "How long does a typical consulting engagement last?",
 "acceptedAnswer": {
 "@type": "Answer",
 "text": "Engagement length depends on scope. A factory productivity audit can be completed in 1–2 weeks. OEE implementation typically runs 3–6 months for full system deployment. Kaizen and CI programs commonly run 3–12 months depending on the number of improvement projects targeted."
 }
 },
 {
 "@type": "Question",
 "name": "Do you work with SMEs or only large manufacturers?",
 "acceptedAnswer": {
 "@type": "Answer",
        "text": "Both. I have worked with multinational manufacturers and Malaysian SMEs across 80+ organisations and project sites, including Intel, Safran, Panasonic, Petronas, Maxeon, Sharp, Carotino, and companies under TERAJU Pritech4.0. The approach is scaled to the size and complexity of your operation."
 }
 },
 {
 "@type": "Question",
 "name": "Which industries do you serve?",
 "acceptedAnswer": {
 "@type": "Answer",
 "text": "Primarily manufacturing — electronics, automotive, food & beverage, palm oil, aerospace, and general industrial. I also have aviation MRO experience from my earlier career with Malaysia Airlines Engineering."
 }
 },
 {
 "@type": "Question",
 "name": "How do I get started with a consulting engagement?",
 "acceptedAnswer": {
 "@type": "Answer",
 "text": "Contact me directly at husnihalim@visiarmada.com or call +60165261901. Share a brief description of your operational challenge. I will follow up to arrange an initial discovery conversation — no commitment required at that stage."
 }
 },
 {
 "@type": "Question",
 "name": "How do I claim HRDC (HRDF) for Lean Manufacturing training in Malaysia?",
 "acceptedAnswer": {
 "@type": "Answer",
 "text": "HRDC-registered employers can claim training fees under the SBL-Khas scheme. Husni Halim is an HRDC Accredited Trainer (TTT No. 10228), so all training programmes are fully claimable. Submit your application via the HRDC e-TRiS portal before the training date. We assist clients with the paperwork."
 }
 },
 {
 "@type": "Question",
 "name": "How long does a factory consulting engagement take?",
 "acceptedAnswer": {
 "@type": "Answer",
 "text": "Our signature programme is a 90-Day Floor Turnaround. Most clients see measurable OEE improvements within the first 30 days. The full engagement covers diagnosis, kaizen implementation, and capability building to sustain results after we leave."
 }
 },
 {
 "@type": "Question",
 "name": "What industries do you serve in Malaysia?",
 "acceptedAnswer": {
 "@type": "Answer",
 "text": "We serve electronics and semiconductor manufacturing, automotive, food and beverage, palm oil, aerospace (MRO), and general industrial manufacturers across Penang, Johor, Selangor, nationwide, and internationally. Past organisations and project sites include Intel, Safran, Panasonic, Petronas, Maxeon, Sharp, Carotino, and 80+ companies across 11 countries and 21 international factories."
 }
 },
 {
 "@type": "Question",
 "name": "What results can I expect from Lean or OEE consulting?",
 "acceptedAnswer": {
 "@type": "Answer",
 "text": "Based on our track record across 30+ Malaysian factories: average 37% reduction in production waste, 29% reduction in operational mistakes, and measurable OEE improvements within 90 days. Results vary by baseline and industry."
 }
 },
 {
 "@type": "Question",
 "name": "What is the difference between Kaizen training and Lean consulting?",
 "acceptedAnswer": {
 "@type": "Answer",
 "text": "Kaizen training builds your team's continuous improvement skills — tools, mindset, and problem-solving. Lean consulting is hands-on work alongside your team on the factory floor to implement improvements and drive measurable results. We offer both, and often combine them for sustained change."
 }
 },
 {
 "@type": "Question",
 "name": "Do you offer on-site consulting outside Kuala Lumpur?",
 "acceptedAnswer": {
 "@type": "Answer",
 "text": "Yes. We serve manufacturers nationwide — Penang, Johor Bahru, Shah Alam, Ipoh, Melaka, and beyond. Our consultants travel to your facility. Contact us for a free factory assessment."
 }
 }
 ]
 }
 </script>

 <style>
 /* ===========================
 RESET & TOKENS
 =========================== */
 *, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }

 :root {
 --navy: #0c1b2e;
 --gold: #c47832;
 --cream: #faf8f5;
 --warm: #ece8e3;
 --plum: #8b2252;
 --text: #2d3748;
 --muted: #6b7280;
 --white: #ffffff;
 }

 html { scroll-behavior:smooth; }

 body {
 font-family: 'DM Sans', sans-serif;
 background: var(--cream);
 color: var(--text);
 font-size: 15px;
 line-height: 1.6;
 -webkit-font-smoothing: antialiased;
 }

 img { max-width:100%; height:auto; display:block; }
 a { color: inherit; text-decoration: none; }

 /* ===========================
 TYPOGRAPHY
 =========================== */
 .serif { font-family: 'Cormorant Garamond', serif; }

 h1, h2, h3 { font-family: 'Cormorant Garamond', serif; font-weight: 600; line-height: 1.15; }

 h1 {
 font-size: clamp(38px, 9vw, 68px);
 color: var(--white);
 }
 h1 em { color: var(--gold); font-style: italic; }

 h2 {
 font-size: clamp(30px, 6vw, 48px);
 color: var(--navy);
 }
 h2 em { color: var(--gold); font-style: italic; }

 h3 {
 font-size: clamp(20px, 4vw, 26px);
 color: var(--navy);
 }

 /* ===========================
 LAYOUT UTILITIES
 =========================== */
 .container {
 width: 100%;
 max-width: 1100px;
 margin: 0 auto;
 padding: 0 20px;
 }

 .section {
 padding: 60px 20px;
 }

 @media (min-width: 768px) {
 .container { padding: 0 40px; }
 .section { padding: 80px 40px; }
 }

 /* ===========================
 SECTION LABELS
 =========================== */
 .section-label {
 display: flex;
 align-items: center;
 gap: 10px;
 margin-bottom: 14px;
 }
 .section-num { font-size: 11px; color: var(--gold); letter-spacing: 3px; font-weight: 600; }
 .section-name { font-size: 11px; color: var(--muted); letter-spacing: 2px; text-transform: uppercase; }
 .section-name--light { color: rgba(255,255,255,.4); }

 .subtext {
 color: var(--muted);
 font-size: 15px;
 line-height: 1.75;
 max-width: 640px;
 margin-top: 10px;
 }
 .subtext--light { color: rgba(255,255,255,.5); }

 /* ===========================
 NAVIGATION — mobile first
 =========================== */
 nav {
 background: var(--navy);
 padding: 0 20px;
 display: flex;
 align-items: center;
 justify-content: space-between;
 height: 60px;
 position: sticky;
 top: 0;
 z-index: 100;
 }

 .nav-logo {
 font-family: 'Cormorant Garamond', serif;
 font-size: 20px;
 color: var(--white);
 font-weight: 600;
 letter-spacing: .3px;
 }
 .nav-logo em { color: var(--gold); font-style: italic; }

 /* Links hidden on mobile */
 .nav-links { display: none; }

 @media (min-width: 900px) {
 nav { padding: 0 40px; height: 66px; }
 .nav-links {
 display: flex;
 gap: 26px;
 list-style: none;
 align-items: center;
 }
 .nav-links a {
 color: rgba(255,255,255,.72);
 font-size: 13px;
 letter-spacing: .4px;
 transition: color .2s;
 }
 .nav-links a:hover { color: var(--white); }
 .nav-links .active { color: var(--gold); }
 .nav-cta {
 background: var(--gold);
 color: var(--white) !important;
 padding: 8px 18px;
 border-radius: 3px;
 }
 }

 /* ===========================
 HERO
 =========================== */
 .page-hero {
 background: var(--navy);
 padding: 60px 20px 56px;
 position: relative;
 overflow: hidden;
 }
 .page-hero::before {
 content: '';
 position: absolute;
 inset: 0;
 background: radial-gradient(ellipse at 30% 60%, rgba(139,34,82,.15) 0%, transparent 65%);
 pointer-events: none;
 }

 .hero-inner {
 max-width: 1100px;
 margin: 0 auto;
 display: grid;
 grid-template-columns: 1fr;
 gap: 36px;
 }

 .page-label {
 display: inline-flex;
 align-items: center;
 gap: 10px;
 color: var(--gold);
 font-size: 11px;
 letter-spacing: 3px;
 text-transform: uppercase;
 margin-bottom: 16px;
 }
 .page-label::before {
 content: '';
 width: 28px;
 height: 1px;
 background: var(--gold);
 opacity: .5;
 }

 .hero-tagline {
 color: rgba(255,255,255,.6);
 font-size: 15px;
 line-height: 1.8;
 margin: 16px 0 24px;
 max-width: 520px;
 }

 /* Stats strip — mobile: column, desktop: row */
 .hero-stat-row {
 display: grid;
 grid-template-columns: repeat(5, minmax(0, 1fr));
 gap: 20px 22px;
 }
 .h-stat { border-left: 2px solid var(--gold); padding-left: 14px; min-width: 0; }
 .h-stat-num {
 font-family: 'Cormorant Garamond', serif;
 font-size: 34px;
 color: var(--white);
 font-weight: 600;
 line-height: 1;
 }
 .h-stat-label {
 font-size: 11px;
 color: rgba(255,255,255,.45);
 letter-spacing: .4px;
 margin-top: 4px;
 }

 /* Distinction box */
 .hero-distinction {
 background: rgba(255,255,255,.05);
 border: 1px solid rgba(255,255,255,.1);
 border-radius: 6px;
 padding: 24px;
 }
 .distinction-header {
 font-size: 10px;
 color: rgba(255,255,255,.35);
 letter-spacing: 2px;
 text-transform: uppercase;
 margin-bottom: 18px;
 }
 .distinction-row {
 display: flex;
 gap: 16px;
 margin-bottom: 18px;
 padding-bottom: 18px;
 border-bottom: 1px solid rgba(255,255,255,.07);
 }
 .distinction-row:last-child { margin-bottom: 0; padding-bottom: 0; border-bottom: none; }
 .d-icon {
 width: 36px;
 height: 36px;
 border-radius: 50%;
 display: flex;
 align-items: center;
 justify-content: center;
 font-size: 16px;
 flex-shrink: 0;
 }
 .d-icon.training { background: rgba(196,120,50,.15); }
 .d-icon.consulting{ background: rgba(139,34,82,.15); }
 .d-content h4 {
 font-size: 12px;
 font-weight: 600;
 color: var(--white);
 margin-bottom: 4px;
 letter-spacing: .3px;
 }
 .d-content p {
 font-size: 11px;
 color: rgba(255,255,255,.45);
 line-height: 1.65;
 }

 @media (min-width: 768px) {
 .page-hero { padding: 90px 40px 80px; }
 .hero-inner { grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
 }

 /* ===========================
 INTRO STRIP
 =========================== */
 .intro-strip {
 background: var(--white);
 border-bottom: 1px solid var(--warm);
 padding: 28px 20px;
 }
 .intro-strip p {
 max-width: 860px;
 margin: 0 auto;
 font-size: 15px;
 color: var(--text);
 line-height: 1.8;
 text-align: center;
 }
 .intro-strip strong { color: var(--navy); }

 @media (min-width: 768px) {
 .intro-strip { padding: 32px 40px; }
 .intro-strip p { font-size: 16px; }
 }

 /* ===========================
 SERVICES GRID
 =========================== */
 .services-section { background: var(--cream); }

 .services-grid {
 display: grid;
 grid-template-columns: 1fr;
 gap: 20px;
 margin-top: 40px;
 }
 @media (min-width: 640px) { .services-grid { grid-template-columns: repeat(2,1fr); } }

 .service-card {
 background: var(--white);
 border: 1px solid var(--warm);
 border-radius: 6px;
 padding: 28px 24px;
 position: relative;
 overflow: hidden;
 transition: box-shadow .2s;
 }
 .service-card:hover { box-shadow: 0 6px 24px rgba(12,27,46,.08); }
 .service-card::after {
 content: '';
 position: absolute;
 bottom: 0; left: 0; right: 0;
 height: 3px;
 background: linear-gradient(90deg, var(--gold), var(--plum));
 }

 .service-icon {
 width: 46px;
 height: 46px;
 background: rgba(196,120,50,.08);
 border-radius: 4px;
 display: flex;
 align-items: center;
 justify-content: center;
 font-size: 20px;
 margin-bottom: 18px;
 }

 .service-card h3 {
 font-size: clamp(19px, 3.5vw, 23px);
 color: var(--navy);
 margin-bottom: 10px;
 }

 .service-card p {
 font-size: 13px;
 color: var(--muted);
 line-height: 1.8;
 margin-bottom: 16px;
 }

 .service-list {
 list-style: none;
 }
 .service-list li {
 font-size: 12px;
 color: var(--text);
 padding: 5px 0 5px 16px;
 position: relative;
 border-bottom: 1px solid var(--warm);
 }
 .service-list li:last-child { border-bottom: none; }
 .service-list li::before { content: '›'; position: absolute; left: 0; color: var(--gold); font-weight: 700; }

 /* ===========================
 FLAGSHIP ENGAGEMENTS
 =========================== */
 .flagship-section { background: var(--navy); }
 .flagship-section h2 { color: var(--white); }
 .flagship-section .subtext { color: rgba(255,255,255,.45); }

 .flagship-grid {
 display: grid;
 grid-template-columns: 1fr;
 gap: 18px;
 margin-top: 40px;
 }
 @media (min-width: 480px) { .flagship-grid { grid-template-columns: repeat(2,1fr); } }
 @media (min-width: 900px) { .flagship-grid { grid-template-columns: repeat(4,1fr); } }

 .flagship-card {
 background: rgba(255,255,255,.04);
 border: 1px solid rgba(255,255,255,.08);
 border-radius: 6px;
 padding: 24px 20px;
 position: relative;
 overflow: hidden;
 transition: background .2s, transform .2s;
 }
 .flagship-card:hover { background: rgba(255,255,255,.07); transform: translateY(-2px); }
 .flagship-card::before {
 content: '';
 position: absolute;
 top: 0; left: 0;
 width: 100%; height: 2px;
 background: var(--gold);
 }

 .flag-year {
 font-size: 10px;
 letter-spacing: 2px;
 color: var(--gold);
 text-transform: uppercase;
 margin-bottom: 10px;
 }
 .flagship-card h3 {
 font-family: 'Cormorant Garamond', serif;
 font-size: 19px;
 color: var(--white);
 margin-bottom: 10px;
 font-weight: 600;
 line-height: 1.3;
 }
 .flagship-card p {
 font-size: 12px;
 color: rgba(255,255,255,.45);
 line-height: 1.7;
 margin-bottom: 16px;
 }
 .flag-stat { display: flex; align-items: baseline; gap: 6px; }
 .flag-num {
 font-family: 'Cormorant Garamond', serif;
 font-size: 30px;
 color: var(--gold);
 font-weight: 600;
 }
 .flag-label { font-size: 11px; color: rgba(255,255,255,.35); }

 /* ===========================
 METHODOLOGY
 =========================== */
 .method-section { background: var(--warm); }

 .method-steps {
 display: grid;
 grid-template-columns: 1fr;
 gap: 28px;
 margin-top: 40px;
 }
 @media (min-width: 640px) { .method-steps { grid-template-columns: repeat(2,1fr); } }
 @media (min-width: 900px) {
 .method-steps {
 grid-template-columns: repeat(4,1fr);
 position: relative;
 }
 .method-steps::before {
 content: '';
 position: absolute;
 top: 23px;
 left: 12%; right: 12%;
 height: 1px;
 background: var(--gold);
 opacity: .25;
 z-index: 0;
 }
 }

 .method-step { text-align: center; padding: 0 12px; position: relative; z-index: 1; }
 .step-circle {
 width: 48px;
 height: 48px;
 border-radius: 50%;
 background: var(--navy);
 color: var(--white);
 font-family: 'Cormorant Garamond', serif;
 font-size: 20px;
 font-weight: 600;
 display: flex;
 align-items: center;
 justify-content: center;
 margin: 0 auto 14px;
 border: 2px solid var(--gold);
 }
 .method-step h4 {
 font-size: 15px;
 font-weight: 600;
 color: var(--navy);
 margin-bottom: 8px;
 }
 .method-step p { font-size: 13px; color: var(--muted); line-height: 1.65; }

 /* ===========================
 TESTIMONIAL
 =========================== */
 .testi-section { background: var(--white); }

 .testi-card {
 background: var(--cream);
 border: 1px solid var(--warm);
 border-radius: 6px;
 padding: 28px 24px;
 max-width: 720px;
 margin-top: 36px;
 }
 .testi-quote {
 font-family: 'Cormorant Garamond', serif;
 font-size: clamp(18px, 3vw, 22px);
 color: var(--navy);
 font-style: italic;
 line-height: 1.55;
 margin-bottom: 18px;
 }
 .testi-source { font-size: 12px; color: var(--gold); font-weight: 600; letter-spacing: .4px; }

 /* ===========================
 FAQ
 =========================== */
 .faq-section { background: var(--cream); }

 .faq-list {
 margin-top: 36px;
 display: flex;
 flex-direction: column;
 gap: 0;
 border: 1px solid var(--warm);
 border-radius: 6px;
 overflow: hidden;
 max-width: 820px;
 }
 .faq-item {
 border-bottom: 1px solid var(--warm);
 padding: 20px 22px;
 background: var(--white);
 }
 .faq-item:last-child { border-bottom: none; }
 .faq-item h3 {
 font-family: 'DM Sans', sans-serif;
 font-size: 14px;
 font-weight: 600;
 color: var(--navy);
 margin-bottom: 8px;
 }
 .faq-item p { font-size: 13px; color: var(--muted); line-height: 1.75; }

 /* ===========================
 CTA SECTION
 =========================== */
 .cta-section {
 background: var(--navy);
 padding: 64px 20px;
 text-align: center;
 position: relative;
 overflow: hidden;
 }
 .cta-section::before {
 content: '';
 position: absolute;
 inset: 0;
 background: radial-gradient(ellipse at 70% 50%, rgba(196,120,50,.08) 0%, transparent 65%);
 pointer-events: none;
 }
 .cta-section h2 {
 color: var(--white);
 margin-bottom: 14px;
 }
 .cta-section p {
 color: rgba(255,255,255,.55);
 max-width: 520px;
 margin: 0 auto 32px;
 font-size: 15px;
 line-height: 1.75;
 }
 .cta-btns {
 display: flex;
 gap: 14px;
 justify-content: center;
 flex-wrap: wrap;
 }
 .btn-gold {
 background: var(--gold);
 color: var(--white);
 padding: 14px 30px;
 border-radius: 3px;
 font-size: 14px;
 font-weight: 600;
 min-height: 48px;
 display: inline-flex;
 align-items: center;
 transition: background .2s;
 }
 .btn-gold:hover { background: #b36c2b; }
 .btn-outline {
 border: 1.5px solid rgba(255,255,255,.28);
 color: var(--white);
 padding: 14px 30px;
 border-radius: 3px;
 font-size: 14px;
 min-height: 48px;
 display: inline-flex;
 align-items: center;
 transition: border-color .2s, background .2s;
 }
 .btn-outline:hover { border-color: rgba(255,255,255,.5); background: rgba(255,255,255,.04); }

 @media (min-width: 768px) {
 .cta-section { padding: 80px 40px; }
 }

 /* ===========================
 FOOTER
 =========================== */
 .site-footer {
 background: var(--navy);
 border-top: 1px solid rgba(255,255,255,.07);
 padding: 28px 20px;
 text-align: center;
 }
 .footer-links {
 display: flex;
 flex-wrap: wrap;
 justify-content: center;
 gap: 10px 20px;
 margin-bottom: 14px;
 list-style: none;
 }
 .footer-links a { font-size: 12px; color: rgba(255,255,255,.45); letter-spacing: .3px; }
 .footer-links a:hover { color: var(--gold); }
 .footer-copy { font-size: 11px; color: rgba(255,255,255,.3); letter-spacing: .5px; }

 @media (min-width: 768px) {
 .site-footer { padding: 32px 40px; }
 }

 /* ---- NAV DROPDOWN ---- */
 .nav-dropdown { position:relative; }
 .dropdown-menu {
   display:none;
   position:absolute;
   top:calc(100% + 4px);
   left:50%;
   transform:translateX(-50%);
   background:#0c1b2e;
   border-top:2px solid var(--gold);
   min-width:240px;
   z-index:300;
   list-style:none;
   padding:4px 0;
   box-shadow:0 12px 36px rgba(0,0,0,.5);
   border-radius:0 0 4px 4px;
 }
 .dropdown-menu li a {
   display:block;
   padding:9px 20px;
   color:rgba(255,255,255,.7);
   font-size:12px;
   letter-spacing:.3px;
   text-decoration:none;
   border-bottom:1px solid rgba(255,255,255,.05);
   transition:background .15s, color .15s;
   white-space:nowrap;
 }
 .dropdown-menu li:last-child a { border-bottom:none; }
 .dropdown-menu li a:hover { background:rgba(255,255,255,.07); color:#fff; }
 .nav-dropdown:hover .dropdown-menu,
 .nav-dropdown:focus-within .dropdown-menu { display:block; }
 .nav-dropdown > a::after { content:' ▾'; font-size:9px; opacity:.7; }

   /* ============================================================
      SITE NAV — unified across all pages
   ============================================================ */
   nav#site-nav {
     background: var(--navy);
     padding: 0 20px;
     display: flex;
     align-items: center;
     justify-content: space-between;
     height: 60px;
     position: sticky;
     top: 0;
     z-index: 100;
     flex-wrap: wrap;
   }

   .nav-logo {
     font-family: 'Cormorant Garamond', serif;
     font-size: 20px;
     color: #fff;
     font-weight: 600;
     letter-spacing: .3px;
     text-decoration: none;
     flex-shrink: 0;
   }
   .nav-logo em { color: var(--gold); font-style: italic; }

   /* Hamburger button — visible on mobile only */
   .nav-hamburger {
     display: flex;
     flex-direction: column;
     justify-content: center;
     gap: 5px;
     width: 36px;
     height: 36px;
     cursor: pointer;
     background: none;
     border: none;
     padding: 4px;
   }
   .nav-hamburger span {
     display: block;
     width: 22px;
     height: 2px;
     background: rgba(255,255,255,.72);
     border-radius: 2px;
     transition: all .25s;
   }

   /* Desktop nav links — hidden on mobile by default */
   .nav-links {
     display: none;
     list-style: none;
     margin: 0;
     padding: 0;
   }

   /* Mobile open state */
   nav#site-nav.nav-open {
     height: auto;
     padding-bottom: 12px;
     align-items: flex-start;
   }
   nav#site-nav.nav-open > .nav-logo,
   nav#site-nav.nav-open > .nav-hamburger {
     margin-top: 14px;
   }
   nav#site-nav.nav-open .nav-links {
     display: flex;
     flex-direction: column;
     width: 100%;
     border-top: 1px solid rgba(255,255,255,.08);
     padding-top: 6px;
     margin-top: 10px;
     gap: 0;
   }
   nav#site-nav.nav-open .nav-links > li > a {
     display: block;
     padding: 11px 4px;
     border-bottom: 1px solid rgba(255,255,255,.05);
     color: rgba(255,255,255,.78);
     font-size: 14px;
     text-decoration: none;
   }
   nav#site-nav.nav-open .dropdown-menu {
     display: flex !important;
     flex-direction: column;
     padding-left: 16px;
     padding-bottom: 4px;
   }
   nav#site-nav.nav-open .dropdown-menu a {
     padding: 7px 0;
     color: rgba(255,255,255,.5);
     font-size: 13px;
     border: none !important;
   }

   /* Desktop (≥ 960px) */
   @media (min-width: 960px) {
     nav#site-nav {
       padding: 0 40px;
       height: 66px;
       flex-wrap: nowrap;
       align-items: center;
     }
     .nav-hamburger { display: none; }

     .nav-links {
       display: flex !important;
       flex-direction: row;
       align-items: center;
       gap: 0;
       width: auto;
       border: none;
       margin: 0;
       padding: 0;
     }
     .nav-links > li {
       position: relative;
     }
     .nav-links > li > a {
       display: flex;
       align-items: center;
       height: 66px;
       padding: 0 13px;
       color: rgba(255,255,255,.68);
       font-size: 13px;
       letter-spacing: .4px;
       white-space: nowrap;
       transition: color .2s;
       text-decoration: none;
     }
     .nav-links > li > a:hover { color: #fff; }
     .nav-links > li.active > a { color: var(--gold); }

     /* Dropdown chevron */
     .nav-dropdown > a::after {
       content: '';
       display: inline-block;
       width: 0;
       height: 0;
       border-left: 3.5px solid transparent;
       border-right: 3.5px solid transparent;
       border-top: 4px solid rgba(255,255,255,.4);
       margin-left: 5px;
       vertical-align: middle;
       transition: transform .2s;
     }
     .nav-dropdown:hover > a::after { transform: rotate(180deg); }

     /* Dropdown panel */
     .dropdown-menu {
       display: none;
       position: absolute;
       top: 100%;
       left: -8px;
       background: #0d2035;
       border: 1px solid rgba(255,255,255,.09);
       border-top: 2px solid var(--gold);
       border-radius: 0 0 6px 6px;
       padding: 6px 0;
       min-width: 230px;
       z-index: 200;
       box-shadow: 0 12px 32px rgba(0,0,0,.4);
     }
     .nav-dropdown:hover .dropdown-menu { display: block; }
     .dropdown-menu a {
       display: block;
       padding: 10px 20px;
       color: rgba(255,255,255,.62);
       font-size: 13px;
       white-space: nowrap;
       transition: background .15s, color .15s;
       text-decoration: none;
     }
     .dropdown-menu a:hover {
       background: rgba(255,255,255,.05);
       color: #fff;
     }
     .dropdown-divider {
       height: 1px;
       background: rgba(255,255,255,.07);
       margin: 5px 0;
     }

     /* CTA button */
     .nav-links .nav-cta {
       background: var(--gold) !important;
       color: #fff !important;
       height: 34px !important;
       padding: 0 18px !important;
       border-radius: 3px;
       margin-left: 10px;
       font-weight: 600 !important;
       font-size: 13px !important;
       letter-spacing: .3px !important;
     }
     .nav-links .nav-cta:hover { background: #b36c2b !important; }
   }

   /* ============================================================
      SITE FOOTER — unified
   ============================================================ */
   footer {
     background: var(--navy, #0c1b2e);
     padding: 40px 20px;
     text-align: center;
   }
   .footer-logo {
     font-family: 'Cormorant Garamond', serif;
     font-size: 20px;
     color: #fff;
     font-weight: 600;
     margin-bottom: 18px;
     display: block;
   }
   .footer-logo em { color: var(--gold, #c47832); font-style: italic; }
   .footer-links {
     display: flex;
     justify-content: center;
     flex-wrap: wrap;
     gap: 6px 20px;
     margin-bottom: 20px;
   }
   .footer-links a {
     font-size: 13px;
     color: rgba(255,255,255,.5);
     text-decoration: none;
     transition: color .2s;
   }
   .footer-links a:hover { color: var(--gold-light, #c8a96e); }
   .footer-copy { font-size: 12px; color: rgba(255,255,255,.28); }
</style>

